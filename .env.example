# Copia a .env para desarrollo local. En Render, estas se configuran como
# variables de entorno del servicio -- nunca en este archivo con valores
# reales, nunca commiteadas.

NODE_ENV=production
PORT=3000

# Conexion de la app en ejecucion -- SIEMPRE el rol app_runtime (nunca el
# superusuario del proveedor). RLS depende de que esta sea la unica
# conexion que la app usa.
DATABASE_URL=postgres://app_runtime:REPLACE_ME@REPLACE_HOST/REPLACE_DB

PGPOOL_MAX=5
SESSION_DURATION_HOURS=12

# Origin exacto del frontend permitido por CORS -- sin comodines.
ALLOWED_ORIGIN=https://rafaelvegafigueroa-eng.github.io

# Solo para scripts/bootstrapStaging.ts -- NUNCA usadas por la app en
# ejecucion. MIGRATIONS_DATABASE_URL es la conexion administrativa del
# proveedor (superusuario); APP_RUNTIME_PASSWORD es la contraseña real que
# reemplaza el placeholder de la migracion 017.
# MIGRATIONS_DATABASE_URL=postgres://REPLACE_ADMIN_USER:REPLACE_ADMIN_PASSWORD@REPLACE_HOST/REPLACE_DB
# APP_RUNTIME_PASSWORD=REPLACE_ME
